  "conditions": [
    {
      "id": "spirit-shroud-cold-active",
      "name": "Spirit Shroud: Cold",
      "description": "Caster's weapon attacks deal +1d8 cold damage on hit, and the target can't regain HP until the start of the caster's next turn. RAW gates the damage on the target being within 10 ft of the caster — not modeled, the rider fires on every hit (broader than RAW). Slot-level scaling (+1d8 per slot above 3rd, up to +7d8 at slot 9) isn't baked into the condition definition. The heal-block applies via an ApplyCondition TriggerAction (`durationRounds: 1`) that stamps `healing-blocked-active` on the hit target; inside an active encounter the engine auto-expires the condition at the start of the caster's next turn via `planAdvanceTurn` (slice 102). Outside an encounter the consumer manages the expiry.",
      "stackable": false,
      "endsOn": [],
      "effects": [
        {
          "kind": "OnEvent",
          "id": "spirit-shroud-cold-rider",
          "trigger": {
            "eventType": "AttackRolled",
            "filter": {
              "kind": "all",
              "terms": [
                {
                  "kind": "eq",
                  "path": "event.attackerIsSelf",
                  "value": true
                },
                {
                  "kind": "eq",
                  "path": "event.hit",
                  "value": true
                }
              ]
            }
          },
          "actions": [
            {
              "kind": "AddDamage",
              "dice": "1d8",
              "damageType": "cold"
            },
            {
              "kind": "ApplyCondition",
              "conditionId": "healing-blocked-active",
              "durationRounds": 1
            }
          ]
        }
      ]
    },
    {
      "id": "spirit-shroud-necrotic-active",
      "name": "Spirit Shroud: Necrotic",
      "description": "Caster's weapon attacks deal +1d8 necrotic damage on hit, and the target can't regain HP until the start of the caster's next turn. Same shape as the cold variant (see cold variant description for the RAW range gate and slot scaling caveats).",
      "stackable": false,
      "endsOn": [],
      "effects": [
