    {
      "id": "spirit-shroud-radiant-active",
      "name": "Spirit Shroud: Radiant",
      "description": "Caster's weapon attacks deal +1d8 radiant damage on hit, and the target can't regain HP until the start of the caster's next turn. Same shape as the cold variant (see cold variant description).",
      "stackable": false,
      "endsOn": [],
      "effects": [
